{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile, active household reference, and personal UI preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "activeHouseholdId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "currency": {
          "type": "string",
          "enum": ["INR", "USD", "EUR", "GBP"]
        },
        "notificationsEnabled": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "currency", "notificationsEnabled", "updatedAt"]
    },
    "Household": {
      "title": "Household",
      "description": "Shared household ledger workspace connecting partners across devices.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "inviteCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 12,
          "pattern": "^[A-Z0-9]+$"
        },
        "currency": {
          "type": "string",
          "enum": ["INR", "USD", "EUR", "GBP"]
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bankBalance": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "inviteCode", "currency", "ownerId", "bankBalance", "createdAt", "updatedAt"]
    },
    "HouseholdInvite": {
      "title": "HouseholdInvite",
      "description": "Invite code lookup record for joining an existing household without exposing household list.",
      "type": "object",
      "properties": {
        "inviteCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 12,
          "pattern": "^[A-Z0-9]+$"
        },
        "householdId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "householdName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["inviteCode", "householdId", "householdName", "ownerId", "createdAt"]
    },
    "HouseholdMember": {
      "title": "HouseholdMember",
      "description": "Public within-household member record without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["owner", "partner"]
        },
        "inviteCodeUsed": {
          "type": "string",
          "maxLength": 12
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "joinedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Custom categories and multi-month event/goal books such as Pregnancy Checkups or Baby Shower.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "kind": {
          "type": "string",
          "enum": ["expense", "event", "recurring", "savings", "fd", "income"]
        },
        "color": {
          "type": "string",
          "minLength": 4,
          "maxLength": 9,
          "pattern": "^#[0-9a-fA-F]{3,8}$"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "budgetLimit": {
          "type": "number"
        },
        "splitRatio": {
          "type": "number"
        },
        "isTaxDeductibleDefault": {
          "type": "boolean"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "kind", "color", "icon", "budgetLimit", "splitRatio", "isTaxDeductibleDefault", "createdByUid", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Individual or shared financial transaction, event expense, savings deposit, or FD entry.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "amount": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "enum": ["expense", "income", "savings", "fd"]
        },
        "scope": {
          "type": "string",
          "enum": ["shared", "personal"]
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "paidByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "paidByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        },
        "isTaxDeductible": {
          "type": "boolean"
        },
        "recurringId": {
          "type": "string",
          "maxLength": 128
        },
        "receiptSummary": {
          "type": "string",
          "maxLength": 300
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "amount", "type", "scope", "categoryId", "categoryName", "date", "paidByUid", "paidByName", "notes", "isTaxDeductible", "createdByUid", "createdAt", "updatedAt"]
    },
    "RecurringObligation": {
      "title": "RecurringObligation",
      "description": "Scheduled recurring obligation (Monthly EMI, Half-Yearly LIC/Insurance, Yearly Software/Tax).",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "amount": {
          "type": "number"
        },
        "frequency": {
          "type": "string",
          "enum": ["weekly", "monthly", "quarterly", "half_yearly", "yearly"]
        },
        "type": {
          "type": "string",
          "enum": ["expense", "savings", "fd"]
        },
        "scope": {
          "type": "string",
          "enum": ["shared", "personal"]
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "nextDueDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "isTaxDeductible": {
          "type": "boolean"
        },
        "isActive": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "amount", "frequency", "type", "scope", "categoryId", "categoryName", "nextDueDate", "ownerUid", "ownerName", "isTaxDeductible", "isActive", "notes", "createdByUid", "createdAt", "updatedAt"]
    },
    "HouseholdNotification": {
      "title": "HouseholdNotification",
      "description": "Real-time notification event for new transactions, contribution nudges, and member joins.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["transaction_added", "nudge", "recurring_due", "member_joined"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "fromUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "targetCategoryId": {
          "type": "string",
          "maxLength": 128
        },
        "targetAmount": {
          "type": "number"
        },
        "readByUids": {
          "type": "array",
          "description": "Bounded list of member UIDs who have read the notification"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["kind", "title", "message", "fromUid", "fromName", "readByUids", "createdAt"]
    },
    "PushSubscription": {
      "title": "PushSubscription",
      "description": "Persisted Web Push device subscription for reliable lock-screen delivery across stateless server restarts.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "endpoint": {
          "type": "string",
          "minLength": 16,
          "maxLength": 2048
        },
        "p256dh": {
          "type": "string",
          "minLength": 20,
          "maxLength": 256
        },
        "auth": {
          "type": "string",
          "minLength": 10,
          "maxLength": 128
        },
        "deviceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "endpoint", "p256dh", "auth", "deviceLabel", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile and settings."
    },
    "/householdInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/HouseholdInvite" },
      "description": "Direct get-only invite lookup document."
    },
    "/households/{householdId}": {
      "schema": { "$ref": "#/entities/Household" },
      "description": "Shared household ledger metadata."
    },
    "/households/{householdId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/HouseholdMember" },
      "description": "Household membership subcollection."
    },
    "/households/{householdId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Custom categories and event-wise goal books."
    },
    "/households/{householdId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Shared and personal transactions, savings, and FDs."
    },
    "/households/{householdId}/recurring/{recId}": {
      "schema": { "$ref": "#/entities/RecurringObligation" },
      "description": "Recurring obligations (EMIs, insurance, subscriptions, taxes)."
    },
    "/households/{householdId}/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/HouseholdNotification" },
      "description": "Real-time household activity alerts and partner nudges."
    },
    "/households/{householdId}/pushSubscriptions/{subId}": {
      "schema": { "$ref": "#/entities/PushSubscription" },
      "description": "Persisted Web Push device endpoints for lock-screen delivery."
    }
  }
}
